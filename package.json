{
	"name": "bun-playground",
	"license": "ISC",
	"type": "module",
	"scripts": {
		"format": "biome format --write .",
		"cli:start": "bun run --cwd apps/cli start",
		"ts-facts": "bun run --cwd apps/ts-facts start --",
		"client:dev": "bun run --cwd apps/client dev",
		"client:build": "bun run --cwd apps/client build",
		"client:preview": "bun run --cwd apps/client preview",
		"client:typecheck": "bun run --cwd apps/client typecheck",
		"client:test": "bun run --cwd apps/client test",
		"client:test:integration": "bun run --cwd apps/client test:integration",
		"build": "bun run scripts/build.ts",
		"compile:cli": "bun run scripts/compile-cli.ts",
		"test": "bun run scripts/test.ts",
		"lint": "bun run scripts/lint.ts",
		"typecheck": "bun run scripts/typecheck.ts",
		"test:integration": "bun run scripts/test-integration.ts",
		"prepare": "husky",
		"ci": "bun run test && bun run lint && bun run typecheck && bun run test:integration"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"@ai-sdk/mistral": "^3.0.22",
		"@ai-sdk/openai": "^3.0.39",
		"@oclif/core": "^4.8.3",
		"@oclif/plugin-help": "^6.0.0",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-toast": "^1.2.15",
		"@reduxjs/toolkit": "^2.11.0",
		"ai": "^6.0.111",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"lucide-react": "^0.556.0",
		"pgvector": "^0.2.1",
		"picomatch": "^4.0.3",
		"postgres": "^3.4.8",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@tailwindcss/vite": "^4.1.16",
		"@types/bun": "^1.3.10",
		"@types/picomatch": "^4.0.2",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.1.1",
		"husky": "^9.1.7",
		"tailwindcss": "^4.1.16",
		"typescript": "^5.8.2",
		"vite": "^7.1.12",
		"vitest": "^3.2.4",
		"zod": "^4.3.6"
	}
}
